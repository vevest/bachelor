---
import { Icon as IconComponent } from 'webcoreui/astro'
import da from "/icons/languages/da.svg?raw"
import en from "/icons/languages/en.svg?raw"
import map from '/icons/map.svg?raw'
import settings from '/icons/settings.svg?raw'
import advice from '/icons/advice.svg?raw'
import clothes from '/icons/clothes.svg?raw'
import health from '/icons/health.svg?raw'
import laundry from '/icons/laundry.svg?raw'
import meal from '/icons/meal.svg?raw'
import pets from '/icons/pets.svg?raw'
import shelter from '/icons/shelter.svg?raw'
import shower from '/icons/shower.svg?raw'

const iconSet = {
    da,
    en,
    map,
    settings,
    advice,
    clothes,
    health,
    laundry,
    meal,
    pets,
    shelter,
    shower
}
---


<IconComponent iconSet={iconSet} {...Astro.props} />