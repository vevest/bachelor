---
import services from '../../utils/eksempeldata.json'
import type { service } from '../../types/service.type'
import Layout from '../../layouts/Layout.astro'
import ServiceInfo from '../../components/ServiceInfo.astro'

export function getStaticPaths() {
    return services
        .filter((service) => service.deleted_at === null)
        .map((service) => ({
            params: {
                service: service.service_slug
            },
            props: {
                service
            }
        }))
}

interface Props {
    service: service
}

const { service } = Astro.props
---

<Layout>
<ServiceInfo service={service}></ServiceInfo>
</Layout>




