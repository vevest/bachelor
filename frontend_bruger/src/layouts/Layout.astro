---
import Navigation from "../components/Navigation.astro";
import ServiceCard from '../components/ServiceCard.astro'
import type { service } from '../types/service.type'

const exampleService: service = {
  id: '1',
  name: 'Mariatjenesten',
  logo: '/icons/logos/kirkens_korshaer_2.png',
  isOpen: true,
  openUntil: '18:00',
  address: 'Istedgade 20, 1650 København V',
  accommodations: [
    {
      title: 'Hot meal',
      iconPath: '/icons/meal.svg'
    },
    {
      title: 'Shower',
      iconPath: '/icons/shower.svg'
    },
    {
      title: 'Shelter',
      iconPath: '/icons/shelter.svg'
    }
  ]
}
const accommodations = [
    { icon: 'meal', name: 'Free meals' },
    { icon: 'shower', name: 'Showers' },
    { icon: 'shelter', name: 'Sleeping facilities' }
]
import "../styles.scss";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>Astro Basics</title>
  </head>
  <body>
    <slot />
    <Navigation />
    <ServiceCard service={exampleService} />
  </body>
</html>
